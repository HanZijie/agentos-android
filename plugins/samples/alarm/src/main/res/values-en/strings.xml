    <!-- Ring-on-time check page -->
    <string name="reliability_title">Make alarms ring on time</string>
    <string name="reliability_back">Back</string>
    <string name="reliability_intro">Battery and background limits can make an alarm late, or stop it ringing. Check each item below and tap Turn on for any that is not ready.</string>
    <string name="reliability_all_ready">All set</string>
    <plurals name="reliability_problems">
        <item quantity="one">%1$d item needs attention</item>
        <item quantity="other">%1$d items need attention</item>
    </plurals>
    <string name="check_status_on">On</string>
    <string name="check_status_off">Off</string>
    <string name="check_status_off_optional">Off (recommended)</string>
    <string name="check_exact_title">Exact alarms</string>
    <string name="check_exact_body">Lets the app fire in the exact minute you set. Alarm apps get it by default.</string>
    <string name="check_notifications_title">Notifications</string>
    <string name="check_notifications_body">Needed to show a ringing alarm on the lock screen.</string>
    <string name="check_fullscreen_title">Full-screen alerts</string>
    <string name="check_fullscreen_body">Lets the screen light up and show the alarm full screen when it rings.</string>
    <string name="check_battery_title">Battery optimization</string>
    <string name="check_battery_body">Set the app to “Not optimized” so the system is less likely to freeze or delay it in the background. After you tap Turn on, find this app in the list and change it (names vary by system). On stock Android alarms are not affected, so this is optional; on other manufacturers’ systems it is recommended.</string>
    <string name="vendor_section_title">Extra settings on %1$s phones</string>
    <string name="vendor_section_note">Menu names change between system versions. These are the usual paths, for reference only; this app cannot change these switches for you.</string>
    <string name="vendor_label_autostart">Autostart</string>
    <string name="vendor_label_background">Background activity</string>
    <string name="vendor_label_lock">Lock in recents</string>
    <string name="vendor_name_xiaomi">Xiaomi / Redmi</string>
    <string name="vendor_name_huawei">Huawei</string>
    <string name="vendor_name_honor">Honor</string>
    <string name="vendor_name_oppo">OPPO / realme</string>
    <string name="vendor_name_vivo">vivo / iQOO</string>
    <string name="vendor_name_oneplus">OnePlus</string>
    <string name="vendor_xiaomi_autostart">Settings → Apps → Manage apps → Alarm, and turn on “Autostart”.</string>
    <string name="vendor_xiaomi_background">On the same page tap “Battery saver” and choose “No restrictions”.</string>
    <string name="vendor_xiaomi_lock">Open recents, touch and hold (or pull down) the Alarm card, and tap the lock icon.</string>
    <string name="vendor_huawei_autostart">Settings → Apps &amp; services → App launch, find Alarm, turn off “Manage automatically” and turn on “Auto-launch”.</string>
    <string name="vendor_huawei_background">In the same place turn on “Run in background” and “Secondary launch”.</string>
    <string name="vendor_huawei_lock">Open the multitasking screen and pull the Alarm card down to lock it.</string>
    <string name="vendor_honor_autostart">Settings → Apps → App launch, find Alarm, turn off “Manage automatically” and turn on “Auto-launch”.</string>
    <string name="vendor_honor_background">In the same place turn on “Run in background”.</string>
    <string name="vendor_honor_lock">Open the multitasking screen and pull the Alarm card down to lock it.</string>
    <string name="vendor_oppo_autostart">Settings → App management → Alarm, and turn on “Allow auto-start” under permissions or battery management.</string>
    <string name="vendor_oppo_background">On the same page, under battery management, choose “Allow background activity”.</string>
    <string name="vendor_oppo_lock">Open recents and pull the Alarm card down (or use the card’s menu at the top right) to lock it.</string>
    <string name="vendor_vivo_autostart">In iManager (or Settings → Apps &amp; permissions → Permission management) turn on “Autostart” for Alarm.</string>
    <string name="vendor_vivo_background">Settings → Battery → Background power consumption, choose Alarm and allow high background usage.</string>
    <string name="vendor_vivo_lock">Open the multitasking screen and pull down (or touch and hold) the Alarm card to lock it.</string>
    <string name="vendor_oneplus_autostart">Settings → Apps → App management → Alarm → Battery, and turn on “Allow auto-launch”.</string>
    <string name="vendor_oneplus_background">Settings → Battery → More settings → Optimize battery use, and set Alarm to “Don’t optimize”.</string>
    <string name="vendor_oneplus_lock">Open recents and tap the lock icon on the Alarm card.</string>

