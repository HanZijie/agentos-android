    <string name="check_status_off">未开启</string>
    <string name="check_status_off_optional">未开启（建议）</string>
    <string name="check_exact_title">精确闹钟</string>
    <string name="check_exact_body">允许 App 在设定的那一分钟准时触发。闹钟类 App 系统默认授予。</string>
    <string name="check_notifications_title">通知</string>
    <string name="check_notifications_body">响铃时需要通知权限，才能在锁屏上显示闹钟。</string>
    <string name="check_fullscreen_title">全屏通知</string>
    <string name="check_fullscreen_body">允许后，闹钟响起时会点亮屏幕并全屏显示。</string>
    <string name="check_battery_title">忽略电池优化</string>
    <string name="check_battery_body">设为“不优化”，系统就不太会在后台冻结或推迟本 App。点“去开启”后，在列表里找到本 App 修改（名称因系统而异）。原生 Android 上闹钟不受影响，可以不设置；国产系统建议开启。</string>
    <string name="vendor_section_title">%1$s手机的额外设置</string>
    <string name="vendor_section_note">各家系统的菜单名称随版本变化，下面是常见路径，仅供参考；本 App 无法替你修改这些开关。</string>
    <string name="vendor_label_autostart">自启动</string>
    <string name="vendor_label_background">后台活动</string>
    <string name="vendor_label_lock">多任务加锁</string>
    <string name="vendor_name_xiaomi">小米 / 红米</string>
    <string name="vendor_name_huawei">华为</string>
    <string name="vendor_name_honor">荣耀</string>
    <string name="vendor_name_oppo">OPPO / realme</string>
    <string name="vendor_name_vivo">vivo / iQOO</string>
    <string name="vendor_name_oneplus">一加</string>
    <string name="vendor_xiaomi_autostart">设置 → 应用设置 → 应用管理 → 闹钟，打开“自启动”。</string>
    <string name="vendor_xiaomi_background">在同一页点“省电策略”，选“无限制”。</string>
    <string name="vendor_xiaomi_lock">打开最近任务，长按（或下拉）“闹钟”卡片，点锁形图标。</string>
    <string name="vendor_huawei_autostart">设置 → 应用和服务 → 应用启动管理，找到“闹钟”，关闭“自动管理”，打开“允许自启动”。</string>
    <string name="vendor_huawei_background">在同一处打开“允许后台活动”和“允许关联启动”。</string>
    <string name="vendor_huawei_lock">打开多任务界面，下拉“闹钟”卡片加锁。</string>
    <string name="vendor_honor_autostart">设置 → 应用 → 应用启动管理，找到“闹钟”，关闭“自动管理”，打开“允许自启动”。</string>
    <string name="vendor_honor_background">在同一处打开“允许后台活动”。</string>
    <string name="vendor_honor_lock">打开多任务界面，下拉“闹钟”卡片加锁。</string>
    <string name="vendor_oppo_autostart">设置 → 应用管理 → “闹钟”，在权限或耗电管理里打开“允许自启动”。</string>
    <string name="vendor_oppo_background">在同一页的“耗电管理”里选“允许后台行为”。</string>
    <string name="vendor_oppo_lock">打开最近任务，下拉“闹钟”卡片（或点卡片右上角菜单）加锁。</string>
    <string name="vendor_vivo_autostart">在 i管家（或设置 → 应用与权限 → 权限管理）里打开“自启动”，勾选“闹钟”。</string>
    <string name="vendor_vivo_background">设置 → 电池 → 后台耗电管理，选“闹钟”，允许后台高耗电。</string>
    <string name="vendor_vivo_lock">打开多任务界面，下拉（或长按）“闹钟”卡片加锁。</string>
    <string name="vendor_oneplus_autostart">设置 → 应用 → 应用管理 → “闹钟” → 电池，打开“允许自启动”。</string>
    <string name="vendor_oneplus_background">设置 → 电池 → 更多设置 → 优化电池使用，把“闹钟”设为“不优化”。</string>
    <string name="vendor_oneplus_lock">打开最近任务，点“闹钟”卡片上的锁定图标。</string>

