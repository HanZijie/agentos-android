{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "calendar",
  "version": "1.0.0",
  "description": "读写这台手机上「日历」App 里的日历和日程：查看、创建、修改、删除、搜索，查空闲时段",
  "extensions": {
    "com.openai": {
      "interface": { "displayName": "日历" }
    },
    "org.agentos": {
      "mcpServers": {
        "calendar": { "service": "org.agentos.sample.calendar.agent.CalendarMcpService" }
      }
    }
  }
}
