<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <string name="app_name">短信</string>

    <!-- 底部导航 -->
    <string name="tab_status">状态</string>
    <string name="tab_chats">会话</string>
    <string name="tab_agent">Agent 发送</string>
    <string name="tab_settings">设置</string>

    <!-- 状态页 -->
    <string name="status_title_full">完整模式</string>
    <string name="status_title_partial">部分可用</string>
    <string name="status_title_compose">仅撰写模式</string>
    <string name="status_body_full">Agent 可以读取、搜索和发送短信；每次发送都要你在 AgentOS 里确认。</string>
    <string name="status_body_partial">缺少一项短信权限，对应的工具会返回错误。</string>
    <string name="status_body_compose">没有短信权限：Agent 只能用“撰写”把草稿交给系统短信界面，由你自己点发送。</string>
    <string name="perm_read">读取短信</string>
    <string name="perm_send">发送短信</string>
    <string name="perm_granted">已授予</string>
    <string name="perm_missing">未授予</string>
    <string name="perm_grant_button">授予短信权限</string>

    <string name="guide_title">无法授予？先“允许受限制的设置”</string>
    <string name="guide_intro">从 Android 15 起，不是从应用商店安装的 App 申请短信权限会被系统限制。这是系统的保护，不是出错了。按下面三步解除一次即可。</string>
    <string name="guide_step1">打开应用信息</string>
    <string name="guide_step2">点右上角 ⋮，选“允许受限制的设置”（可能要验证锁屏密码）</string>
    <string name="guide_step3">回到这里，再点“授予短信权限”</string>
    <string name="guide_open_info">打开应用信息</string>
    <string name="guide_mock_title">应用信息</string>
    <string name="guide_mock_menu">允许受限制的设置</string>
    <string name="guide_note">应用信息里没有这个菜单项？说明系统没有限制本 App，直接授予权限即可。</string>

    <string name="disclosure_title">短信内容的去向</string>
    <string name="disclosure_body">Agent 读取的短信内容会进入会话历史，并发送给你在 AgentOS 里配置的模型端点。发送短信每次都需要你确认，验证码默认遮蔽。本 App 自己不联网，也不是默认短信应用。</string>
    <string name="disclosure_ack">我知道了</string>

    <string name="status_agent_title">Agent 能做什么</string>
    <string name="status_agent_can">列会话、读消息、搜索、发送（高风险，每次确认）、查发送状态、撰写草稿</string>
    <string name="status_agent_cannot">不能：彩信、群发、删除、标已读、选卡槽、自动回复来信</string>

    <!-- 会话页 -->
    <string name="chats_title">会话</string>
    <string name="chats_empty_title">没有短信</string>
