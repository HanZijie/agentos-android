    <!-- 设置页 -->
    <string name="settings_title">设置</string>
    <string name="settings_safety">安全</string>
    <string name="setting_codes_title">允许 Agent 读取验证码</string>
    <string name="setting_codes_off">关闭：验证码显示为 ••••••，对 Agent 和本 App 的会话页都一样。</string>
    <string name="setting_codes_on">开启：验证码会原样进入会话历史，并发送给模型端点。</string>
