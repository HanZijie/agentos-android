<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
          只在 AgentOS 的 debug 包里（:app 的 debugImplementation）。它以 AgentOS 的 UID 运行，能打开 ACP 通道、
          绑定 IAgentControl，所以必须挡住其他 App：要求 android.permission.DUMP，只有 shell（adb）和系统能启动它。
        -->
        <activity
            android:name="org.agentos.test.acp.inapp.AgentScenarioActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:permission="android.permission.DUMP"
            android:process=":acptest" />
    </application>
</manifest>
