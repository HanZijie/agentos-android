# ---- 生成物：由 core/pi-runtime/build.mjs 生成（W3），不手改，不进仓库 ----
app/src/main/assets/pi-agent.js
app/src/main/assets/model-catalog.json

# ---- 打包产物（tools/package-module.py，W7） ----
agentos-*.zip

# 发布目录（tools/package-release.py、tools/package-samples.py 的默认输出）：签名后的 APK、zip、SHA256SUMS 都不进仓库
dist-release/
dist-samples/
