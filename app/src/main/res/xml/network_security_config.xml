<?xml version="1.0" encoding="utf-8"?>
<!--
  lane B（W6/B4）：architecture F9 —— 自定义模型端点只对回环地址允许明文 HTTP（手机上的本地模型服务、
  设备测试的假端点、adb reverse），其他域名保持默认：禁止明文、只信任系统 CA。
  与 core/runtime 的 HostFetch.LOOPBACK_HOSTS 保持一致（HostFetch 在发请求前先拒绝非回环的 http）。
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">::1</domain>
    </domain-config>
</network-security-config>
