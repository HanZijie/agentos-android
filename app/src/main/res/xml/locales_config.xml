<?xml version="1.0" encoding="utf-8"?>
<!--
  AgentOS 支持的界面语言（docs/next-apps-plan.md 7.2 R5）：系统设置里的“应用语言”只列这两种；默认跟随系统，
  系统语言既不是中文也不是英文时回落到默认资源（values/，中文，决定项 D8）。
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
