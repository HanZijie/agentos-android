<?xml version="1.0" encoding="utf-8"?>
<!--
  只进 debug 包的内容（与 app/src/main/AndroidManifest.xml 合并）。release 包里没有它们。
  回环地址的明文 HTTP 放行已移到 main（app/src/main/res/xml/network_security_config.xml，B4，F9），debug 与 release 相同。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!--
          lane A（W9）：电脑端接入的测试入口（tests/acp-conformance 的设备模式用它打开开关、生成配对码）。
          要求 DUMP 权限，只有 adb shell 和系统能发；运行在 :agent。
        -->
        <receiver
            android:name=".agent.DesktopGatewayDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":agent" />

        <!--
          lane C（C7b）：Extension Host 的测试入口（tests/device/mcp-plugin 用它发现、启停插件、调用工具、取消、等目录变化）。
          要求 DUMP 权限；跑在主进程，经 IExtensionHost 访问 :ext（与插件管理页相同的路径）。
        -->
        <receiver
            android:name=".ext.ExtensionDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!--
          整合人：工具确认的 adb 无人值守应答（debug / TEST_HOOKS；D5.2 的真实确认界面接入后仍保留）。
          要求 DUMP 权限；运行在 :agent（ConsentCoordinator 在那里）。
        -->
        <receiver
            android:name=".agent.ConsentDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:process=":agent" />

    </application>

</manifest>
