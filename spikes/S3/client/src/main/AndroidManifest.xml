<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 的包可见性：不声明就 bind 不到 server -->
    <queries>
        <package android:name="org.agentos.spike.s3.agent" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="S3 Client">
        <!-- 场景执行器：由 tools/run_s3.py 用 am start 驱动，结果写到 logcat（tag S3RESULT） -->
        <activity
            android:name=".ScenarioActivity"
            android:exported="true"
            android:launchMode="singleTask" />
    </application>
</manifest>
