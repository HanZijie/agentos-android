<?xml version="1.0" encoding="UTF-8"?>
<!--
  全仓库的 Lint 配置（Lint 会从模块目录向上查找 lint.xml）。
  依赖和工具链版本是在 gradle/libs.versions.toml 里刻意锁定的（docs/implementation-plan.md 第 2 节），
  “有新版本可用”一类提示对这个仓库只是噪音，关掉；升级按计划单独评估。
-->
<lint>
    <issue id="AndroidGradlePluginVersion" severity="ignore" />
    <issue id="GradleDependency" severity="ignore" />
    <issue id="NewerVersionAvailable" severity="ignore" />

    <!--
      中英文资源（docs/next-apps-plan.md 7.2 R9）：缺翻译、多余翻译、格式化占位符对不上都是错误。
      tools/check-i18n.py 在不需要 Android SDK 的 CI 里做同样的对齐检查（还管英文资源里不能有中文、字面量里不能有中文）。
    -->
    <issue id="MissingTranslation" severity="error" />
    <issue id="ExtraTranslation" severity="error" />
    <issue id="StringFormatMatches" severity="error" />
    <issue id="StringFormatInvalid" severity="error" />
</lint>
